<odoo>


<record id="view_order_form" model="ir.ui.view">
    <field name="name">agent.sale.order.form</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
        <field name="user_id" position="after">
            <field name="agent_id"/>
        </field>
    </field>
</record>

<record id="view_quotation_tree" model="ir.ui.view">
    <field name="name">agent.sale.order.tree</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_quotation_tree"/>
    <field name="arch" type="xml">
        <field name="user_id" position="after">
            <field name="agent_id" optional="hide"/>
        </field>
    </field>
</record>

<record id="view_order_tree" model="ir.ui.view">
    <field name="name">agent.sale.order.tree</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_tree"/>
    <field name="arch" type="xml">
        <field name="user_id" position="after">
            <field name="agent_id" optional="hide"/>
        </field>
    </field>
</record>

<record id="view_sales_order_filter" model="ir.ui.view">
    <field name="name">agent.sale.order.search</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_sales_order_filter"/>
    <field name="arch" type="xml">
        <field name="user_id" position="after">
            <field name="agent_id"/>
        </field>
        <filter name="salesperson" position="after">
            <filter name="agent_groupby" string="Agent" context="{'group_by': 'agent_id'}"/>
        </filter>
    </field>
</record>


</odoo>
