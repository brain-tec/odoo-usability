<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="sale_order_view_form" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='note_group']" position="after">
                <group string="Transaction" name="transactions" invisible="not transaction_ids" > 
                <field name="transaction_ids" nolabel="1" colspan="4"  >
                    <list
                        decoration-danger="state in ('error', 'cancel')"
                        decoration-success="state == 'done'"
                        >
                        <field name="reference"/>
                        <field name="create_date"/>
                        <field name="provider_id"/>
                        <field name="amount"/>
                        <field name="state"/>
                    </list>
                </field>
            </group>
            </xpath>
        </field>
    </record>

    <record id="view_order_tree" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_tree" />
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="main_provider_id" optional="hide" />
            </field>
        </field>
    </record>

    <record id="view_quotation_tree" model="ir.ui.view">
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree" />
        <field name="arch" type="xml">
            <field name="currency_id" position="after">
                <field name="main_provider_id" optional="hide" />
            </field>
        </field>
    </record>

</odoo>
